{
  "name": "waitlist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c &#34;NODE_OPTIONS=&#39;--import ./instrument.server.mjs&#39; vite dev --port 3000&#34;",
    "generate-routes": "vp build",
    "build": "vp build &amp;&amp; cp instrument.server.mjs .output/server",
    "preview": "vp preview",
    "lint": "vp lint",
    "format": "vp fmt . && vp lint --fix",
    "check": "vp fmt --check .",
    "deploy": "bun run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@sentry/tanstackstart-react": "^10.67.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.16",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "jsdom": "^31.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd",
      "better-sqlite3",
      "@sentry/cli"
    ]
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
